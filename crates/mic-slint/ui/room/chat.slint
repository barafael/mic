import { LineEdit, ListView, Palette } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { ChatLine } from "../types.slint";

// The chat: what's been said, and a field to say more. Its field has the keyboard when it opens.
export component ChatPanel inherits Rectangle {
    in property <[ChatLine]> chat;
    callback say(string);
    // How many messages it has shown: what's past them is unread.
    callback seen(int);
    property <bool> born;
    init => {
        root.seen(root.chat.length);
        message.focus();
    }
    // Set after the first frame: one set in `init` comes before it, and isn't animated.
    Timer {
        interval: 16ms;
        running: !root.born;
        triggered => {
            root.born = true;
        }
    }
    background: Theme.surface;
    border-radius: 12px;
    opacity: self.born ? 1 : 0;
    animate opacity { duration: 180ms; }
    clip: true;
    // It slides in from the right.
    Rectangle {
        x: root.born ? 0px : 24px;
        animate x {
            duration: 200ms;
            easing: ease-out;
        }
        width: root.width;
        height: root.height;
        VerticalLayout {
            padding: 12px;
            spacing: 8px;
            Text {
                text: "Chat";
                color: Theme.text;
                font-size: 15px;
                font-weight: 600;
            }
            lines := ListView {
                vertical-stretch: 1;
                property <int> count: root.chat.length;
                // It keeps to the newest message while it's at the end, as when it opens: the rows
                // are measured after a message comes, so it follows the content as it grows. Scrolled
                // back to read, it stays there.
                property <length> end: Math.min(0px, self.visible-height - self.content-height);
                property <bool> following: true;
                changed end => {
                    if (self.following) {
                        self.content-y = self.end;
                    }
                }
                changed content-y => {
                    self.following = self.content-y <= self.end + 4px;
                }
                changed count => {
                    root.seen(self.count);
                }
                // A run of one sender's messages: the name and time once, the run close together.
                for line in root.chat: VerticalLayout {
                    padding-top: line.first ? 6px : 1px;
                    padding-bottom: 1px;
                    if line.first: HorizontalLayout {
                        alignment: start;
                        spacing: 6px;
                        Text {
                            horizontal-stretch: 0;
                            text: line.me ? "You" : line.name;
                            color: line.me ? Theme.accent-hover : Theme.text-dim;
                            font-size: 12px;
                            font-weight: 600;
                        }
                        Text {
                            text: line.time;
                            color: Theme.text-dim.transparentize(0.3);
                            font-size: 11px;
                            vertical-alignment: center;
                        }
                    }
                    Text {
                        text: line.text;
                        color: Theme.text;
                        font-size: 13px;
                        wrap: word-wrap;
                    }
                }
            }
            message := LineEdit {
                placeholder-text: "Message everyone";
                accessible-label: "Message everyone";
                accepted => {
                    if (self.text != "") {
                        root.say(self.text);
                        self.text = "";
                    }
                }
            }
        }
    }
}

export component ChatPreview inherits Rectangle {
    // Dark, as the window sets it (app.slint).
    init => {
        Palette.color-scheme = ColorScheme.dark;
    }
    background: Theme.canvas;
    width: 320px;
    height: 420px;
    ChatPanel {
        x: 10px;
        y: 10px;
        width: 300px;
        height: 400px;
        chat: [
            { from: "b", name: "Ben", text: "hello all, can you hear me?", time: "10:00", first: true },
            { from: "a", name: "Ann Example", text: "Loud and clear.", me: true, time: "10:00", first: true },
            { from: "c", name: "Cat", text: "Sharing my screen in a second, the slides are nearly done.", time: "10:00", first: true },
            { from: "d", name: "Dan", text: "Can everyone see the second slide?", time: "10:00", first: true },
            { from: "b", name: "Ben", text: "Yes, the chart with the three bars.", time: "10:00", first: true },
            { from: "e", name: "Eve", text: "Joining late, sorry. What did I miss?", time: "10:00", first: true },
            { from: "a", name: "Ann Example", text: "Just the intro, Cat is on slide two.", me: true, time: "10:00", first: true },
            { from: "c", name: "Cat", text: "Questions at the end, please.", time: "10:00", first: true },
            { from: "d", name: "Dan", text: "One for the end: where's the recording going?", time: "10:00", first: true },
            { from: "b", name: "Ben", text: "Into everyone's Videos folder, mic says so in the banner.", time: "10:00", first: true },
            { from: "e", name: "Eve", text: "Thanks.", time: "10:00", first: true },
        ];
    }
}
