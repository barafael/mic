import { Theme } from "../theme.slint";
import { MenuPanel, MenuRow } from "../widgets/menu.slint";

// The reactions offered, a row of emoji: a click sends one.
export component ReactionPicker inherits MenuPanel {
    // As emoji, in the order `react` numbers them.
    in property <[string]> reactions;
    callback react(int);
    width: picks.preferred-width;
    height: 48px;
    border-radius: 24px;
    picks := HorizontalLayout {
        padding-left: 4px;
        padding-right: 4px;
        for emoji[i] in root.reactions: Rectangle {
            width: 44px;
            border-radius: 20px;
            background: pick.has-hover ? Theme.raised-hover : transparent;
            accessible-role: button;
            accessible-label: emoji;
            accessible-action-default => {
                root.react(i);
            }
            Text {
                width: parent.width;
                height: parent.height;
                horizontal-alignment: center;
                vertical-alignment: center;
                text: emoji;
                font-family: Theme.emoji-font;
                font-size: 22px;
            }
            pick := TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    root.react(i);
                }
            }
        }
    }
}

// A narrow window's More: what doesn't fit its bar.
export component MoreMenu inherits MenuPanel {
    in property <bool> copied;
    in property <bool> hand;
    in property <bool> sharing;
    in property <bool> share-opening;
    in property <bool> recording-self;
    callback copy-invite();
    callback toggle-hand();
    callback toggle-share();
    callback toggle-recording();
    callback toggle-people();
    // React was picked: the reactions take its place.
    callback pick-reaction();
    width: 240px;
    height: rows.preferred-height;
    border-radius: 12px;
    rows := VerticalLayout {
        padding: 6px;
        spacing: 2px;
        MenuRow {
            icon: root.copied ? "check" : "copy";
            text: root.copied ? "Copied" : "Copy invite";
            clicked => {
                root.copy-invite();
            }
        }
        MenuRow {
            icon: "hand";
            lit: root.hand;
            text: root.hand ? "Lower your hand (Ctrl+Alt+H)" : "Raise your hand (Ctrl+Alt+H)";
            clicked => {
                root.toggle-hand();
            }
        }
        MenuRow {
            icon: "screen";
            text: root.sharing ? "Stop sharing your screen" : root.share-opening ? "Cancel sharing" : "Share your screen";
            clicked => {
                root.toggle-share();
            }
        }
        MenuRow {
            icon: "record";
            lit: root.recording-self;
            lit-tint: Theme.danger;
            text: root.recording-self ? "Stop recording" : "Record the call";
            clicked => {
                root.toggle-recording();
            }
        }
        MenuRow {
            icon: "people";
            text: "People";
            clicked => {
                root.toggle-people();
            }
        }
        MenuRow {
            icon: "smile";
            text: "React";
            clicked => {
                root.pick-reaction();
            }
        }
    }
}

export component MenusPreview inherits Rectangle {
    background: Theme.canvas;
    width: 560px;
    height: 260px;
    ReactionPicker {
        x: 20px;
        y: 20px;
        reactions: ["👍", "👏", "😂", "😮", "❤️", "🎉"];
    }
    MoreMenu {
        x: 300px;
        y: 20px;
        hand: true;
    }
}
