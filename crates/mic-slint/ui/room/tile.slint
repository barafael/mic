import { Palette, Spinner } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { Tile } from "../types.slint";
import { Icon } from "../widgets/icon.slint";

// A participant's tile, or a shared screen: its video, else its initials; its name, a raised hand,
// its latest reaction, and a ring while it speaks.
export component TileView inherits Rectangle {
    in property <Tile> tile;
    property <bool> born;
    property <bool> present: self.born && !root.tile.leaving;
    property <bool> showing-video: root.tile.has-video && !root.tile.camera-off;
    property <length> side: Math.min(self.width, self.height);
    // Too small for its name over the picture: the name shows while the pointer is on it.
    property <bool> small: self.height < 90px;
    // A shared screen whose first picture hasn't come.
    property <bool> waiting: root.tile.screen && !root.tile.has-video;
    // A tile comes in growing a little, and goes out shrinking.
    // Set after the first frame: one set in `init` comes before it, and isn't animated.
    Timer {
        interval: 16ms;
        running: !root.born;
        triggered => {
            root.born = true;
        }
    }
    // A newcomer waits while the others make room for it, a move, so it doesn't land on them;
    // one leaving goes at once.
    // Greyed while away, as the room redials: kept, not gone.
    opacity: root.present ? (root.tile.away ? 0.4 : 1) : 0;
    animate opacity {
        delay: root.tile.leaving ? 0ms : Theme.moving;
        duration: 220ms;
        easing: ease-out;
    }
    transform-scale: root.present ? 1 : 0.92;
    animate transform-scale {
        delay: root.tile.leaving ? 0ms : Theme.moving;
        duration: 220ms;
        easing: ease-out;
    }
    background: Theme.tile;
    border-radius: 12px;
    clip: true;
    accessible-role: text;
    accessible-label: root.tile.me ? root.tile.name + " (you)" : root.tile.name;
    hover := TouchArea { }
    avatar := Rectangle {
        visible: !root.waiting;
        width: Math.clamp(root.side * (root.small ? 0.5 : 0.36), 16px, 120px);
        height: self.width;
        y: (root.height - self.height) / 2 - (root.tile.cant-decode != "" ? 14px : 0px);
        border-radius: self.width / 2;
        background: root.tile.tint;
        opacity: root.showing-video ? 0 : 1;
        animate opacity { duration: Theme.moving; }
        Text {
            text: root.tile.initials;
            color: white;
            font-size: parent.width * 0.4;
            font-weight: 600;
        }
    }
    if root.tile.cant-decode != "" && !root.showing-video: Text {
        y: avatar.y + avatar.height + 8px;
        width: root.width - 24px;
        horizontal-alignment: center;
        text: "Can't show their video (" + root.tile.cant-decode + ")";
        color: Theme.text-dim;
        font-size: 12px;
        overflow: elide;
    }
    if root.waiting: VerticalLayout {
        alignment: center;
        spacing: 12px;
        HorizontalLayout {
            alignment: center;
            Spinner {
                indeterminate: true;
                width: 28px;
                height: 28px;
            }
        }
        Text {
            text: "Waiting for " + root.tile.name + "…";
            color: Theme.text-dim;
            font-size: 13px;
            horizontal-alignment: center;
            overflow: elide;
        }
    }
    // Its own camera comes mirrored already (videos.rs).
    Image {
        width: root.width;
        height: root.height;
        source: root.tile.video;
        image-fit: root.tile.screen ? contain : cover;
        opacity: root.showing-video ? 1 : 0;
        visible: self.opacity > 0;
        animate opacity { duration: Theme.moving; }
    }
    // The name, and whether it's muted, at the bottom, over the video if there's one.
    Rectangle {
        opacity: !root.small || hover.has-hover ? 1 : 0;
        animate opacity { duration: Theme.quick; }
        x: 8px;
        y: root.height - self.height - 8px;
        width: Math.min(name-row.preferred-width, root.width - 16px);
        height: 26px;
        border-radius: 13px;
        background: #000000a0;
        name-row := HorizontalLayout {
            padding-left: root.tile.muted ? 6px : 10px;
            padding-right: 10px;
            spacing: 4px;
            if root.tile.muted: Icon {
                kind: "mic-off";
                tint: Theme.danger-hover;
                width: 16px;
                height: 16px;
                y: (parent.height - self.height) / 2;
            }
            Text {
                text: root.tile.me ? root.tile.name + " (you)" : root.tile.name;
                color: white;
                font-size: 13px;
                vertical-alignment: center;
                overflow: elide;
            }
        }
    }
    // A raised hand, in the top corner: it pops in.
    if root.tile.hand: badge := Rectangle {
        property <bool> born;
        // Set after the first frame: one set in `init` comes before it, and isn't animated.
        Timer {
            interval: 16ms;
            running: !badge.born;
            triggered => {
                badge.born = true;
            }
        }
        x: root.small ? 4px : 8px;
        y: root.small ? 4px : 8px;
        width: root.small ? 20px : 30px;
        height: self.width;
        border-radius: self.width / 2;
        background: Theme.warn;
        transform-scale: self.born ? 1 : 0.3;
        animate transform-scale {
            duration: 260ms;
            easing: cubic-bezier(0.34, 1.56, 0.64, 1);
        }
        accessible-role: text;
        accessible-label: "Hand raised";
        Icon {
            kind: "hand";
            tint: #1a1a1a;
            width: parent.width * 0.6;
            height: self.width;
        }
    }
    // A reaction, a moment after it comes, in the other corner.
    property <int> reaction-seq: root.tile.reaction-seq;
    property <bool> reacting;
    changed reaction-seq => {
        if (self.reaction-seq > 0) {
            self.reacting = true;
            reacted-for.running = false;
            reacted-for.running = true;
        }
    }
    reacted-for := Timer {
        interval: 3s;
        running: false;
        triggered => {
            root.reacting = false;
            self.running = false;
        }
    }
    if root.tile.reaction != "": Rectangle {
        x: root.width - self.width - (root.small ? 4px : 8px);
        y: (root.small ? 4px : 8px) + (root.reacting ? 0px : 12px);
        width: root.small ? 28px : 44px;
        height: self.width;
        border-radius: self.width / 2;
        background: #000000a0;
        opacity: root.reacting ? 1 : 0;
        animate opacity, y {
            duration: Theme.moving;
            easing: ease-out;
        }
        Text {
            text: root.tile.reaction;
            font-family: Theme.emoji-font;
            font-size: parent.width * 0.55;
        }
    }
    // Ringed while it speaks.
    Rectangle {
        border-radius: 12px;
        border-width: root.tile.speaking ? 3px : 0px;
        border-color: Theme.accent;
        animate border-width {
            duration: 150ms;
            easing: ease-out;
        }
    }
}

// Tiles in their states, for the preview.
export component TilesPreview inherits Rectangle {
    // Dark, as the window sets it (app.slint).
    init => {
        Palette.color-scheme = ColorScheme.dark;
    }
    background: Theme.canvas;
    width: 660px;
    height: 400px;
    GridLayout {
        padding: 12px;
        spacing: 8px;
        Row {
            TileView {
                tile: { name: "Ann Example", me: true, initials: "AE", tint: #2a8ca8 };
            }
            TileView {
                tile: { name: "Ben", initials: "B", tint: #8a5cd0, muted: true, speaking: true, hand: true };
            }
        }
        Row {
            TileView {
                tile: { name: "Cat", initials: "C", tint: #c0584a, cant-decode: "AV1" };
            }
            TileView {
                tile: { name: "Ann Example's screen", screen: true };
            }
        }
    }
}
