// mic's window: a join screen, and a room's tiles. It shows what the Rust side sets and asks for
// what's clicked through callbacks; it holds no room logic (PLAN.md, "The core and its
// frontends"). The window is put together here from its pages (pages/), the room's parts
// (room/), the widgets they share (widgets/) and the overlays (overlays/); each file's components
// open in Slint's preview on their own, with a `…Preview` beside those that want sample data.

import { AboutSlint, Palette } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { ChatLine, Person, Tile } from "types.slint";
import { JoinScreen } from "pages/join.slint";
import { RoomScreen } from "pages/room.slint";
import { SharePicker } from "overlays/share-picker.slint";
import { LinkQuestion } from "overlays/link-question.slint";
import { SettingsPanel } from "overlays/settings.slint";

export { ChatLine, Person, Theme, Tile }

export component AppWindow inherits Window {
    title: root.room-name != "" ? "mic: " + root.room-name : "mic";
    preferred-width: 960px;
    preferred-height: 600px;
    min-width: 360px;
    min-height: 300px;
    background: Theme.canvas;
    // `join` or `room`.
    in property <string> screen: "join";
    in-out property <string> name;
    in-out property <string> invite;
    in property <bool> joining;
    in property <string> error;
    in property <[Tile]> tiles;
    // Participants not shown, beyond the tiles, and their names.
    in property <int> overflow;
    in property <string> overflow-names;
    // Everyone in the room, for the participants panel.
    in property <[Person]> people;
    in property <string> room-invite;
    in property <string> status;
    in property <string> warning;
    in property <bool> muted;
    in property <bool> camera-off;
    // Whether this participant has a camera that's sent.
    in property <bool> has-camera;
    in property <bool> hand;
    in property <[ChatLine]> chat;
    in property <[string]> reactions;
    in property <[Tile]> screens;
    in property <bool> sharing;
    in property <string> recording;
    in property <bool> recording-self;
    callback toggle-recording();
    in property <bool> share-opening;
    // What there is to share, while the picker asks; empty otherwise.
    in property <[string]> share-choices;
    // Something the room says a moment, as a share that stopped: shown again each time
    // `room-notice-seq` changes.
    in property <string> room-notice;
    in property <int> room-notice-seq;
    // Share, or stop: the picker opens with the choices to share.
    callback toggle-share();
    // The choice of `share-choices` at this index; none (-1) cancels.
    callback share(int);
    callback join(string, string);
    callback new-room();
    callback leave();
    callback toggle-mute();
    callback toggle-camera();
    callback toggle-hand();
    // The reaction of `reactions` at this index.
    callback react(int);
    callback say(string);
    pure callback columns-for(int, length, length) -> int;
    // A link opened during a call, while the window asks whether to leave the call for it; empty
    // otherwise. A link never takes the window to another room without a click (links.rs).
    in property <string> asking;
    // The room the link names, if its invite names it.
    in property <string> asking-name;
    // The room's name, if its invite gives one: in the title.
    in property <string> room-name;
    // Counts the links filled in on the join screen.
    in property <int> filled;
    // What the join screen says under its card, as that the room was left; nothing otherwise.
    in property <string> join-note;
    // Its answer: true to leave for the link's room.
    callback answer(bool);
    in property <string> version;
    // What it says of the version check, if anything (D15), and where to get the newer one.
    in property <string> notice;
    in property <string> notice-link;
    // Opens a link in the browser.
    callback open-link(string);
    // What a join's error was, behind the few words of `error`.
    in property <string> error-details;
    // Whether the call goes over the WebSocket fallback.
    in property <bool> fallback;
    // The notice dismissed, for this run.
    property <bool> notice-dismissed;
    // The settings, while open: the devices by name and which are chosen (main.rs fills them in
    // as it opens), the microphone's level for the meter.
    in-out property <bool> settings-open;
    in property <[string]> microphones;
    in property <[string]> speakers;
    in-out property <int> microphone;
    in-out property <int> speaker;
    in-out property <int> noise;
    in property <float> mic-level;
    in property <bool> has-devices: true;
    callback open-settings();
    callback choose-microphone(int);
    callback choose-speaker(int);
    callback choose-noise(int);
    callback settings-closed();
    // What the name field holds, as it's edited, for the harness.
    callback name-edited(string);
    changed name => {
        root.name-edited(self.name);
    }

    init => {
        Palette.color-scheme = ColorScheme.dark;
    }

    about := PopupWindow {
        x: (root.width - 320px) / 2;
        y: (root.height - 240px) / 2;
        width: 320px;
        height: 240px;
        Rectangle {
            background: Theme.surface;
            border-radius: 12px;
            border-width: 1px;
            border-color: Theme.line;
            VerticalLayout {
                padding: 12px;
                AboutSlint { }
                Text {
                    text: "mic " + root.version;
                    horizontal-alignment: center;
                    color: Theme.text;
                }
            }
        }
    }

    VerticalLayout {
        if root.notice != "" && !root.notice-dismissed: Rectangle {
            background: Theme.accent.transparentize(0.8);
            height: notice-row.preferred-height;
            notice-row := HorizontalLayout {
                padding: 7px;
                padding-left: 12px;
                spacing: 12px;
                Text {
                    text: root.notice;
                    color: Theme.text;
                    font-size: 13px;
                    wrap: word-wrap;
                    vertical-alignment: center;
                }
                if root.notice-link != "": Text {
                    horizontal-stretch: 0;
                    text: "Download";
                    color: download.has-hover ? Theme.text : Theme.accent-hover;
                    font-size: 13px;
                    font-weight: 600;
                    vertical-alignment: center;
                    accessible-role: button;
                    accessible-action-default => {
                        root.open-link(root.notice-link);
                    }
                    download := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.open-link(root.notice-link);
                        }
                    }
                }
                Text {
                    horizontal-stretch: 0;
                    text: "Not now";
                    color: later.has-hover ? Theme.text : Theme.text-dim;
                    font-size: 13px;
                    vertical-alignment: center;
                    accessible-role: button;
                    accessible-action-default => {
                        root.notice-dismissed = true;
                    }
                    later := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.notice-dismissed = true;
                        }
                    }
                }
            }
        }
        if root.screen == "join": JoinScreen {
            vertical-stretch: 1;
            name <=> root.name;
            invite <=> root.invite;
            joining: root.joining;
            error: root.error;
            error-details: root.error-details;
            note: root.join-note;
            filled: root.filled;
            join(name, invite) => {
                root.join(name, invite);
            }
            new-room => {
                root.new-room();
            }
            about => {
                about.show();
            }
            open-settings => {
                root.open-settings();
            }
        }
        if root.screen == "room": RoomScreen {
            vertical-stretch: 1;
            tiles: root.tiles;
            overflow: root.overflow;
            overflow-names: root.overflow-names;
            people: root.people;
            invite: root.room-invite;
            status: root.status;
            warning: root.warning;
            fallback: root.fallback;
            new-room => {
                root.new-room();
            }
            open-settings => {
                root.open-settings();
            }
            muted: root.muted;
            camera-off: root.camera-off;
            has-camera: root.has-camera;
            asking: root.asking != "";
            hand: root.hand;
            chat: root.chat;
            reactions: root.reactions;
            screens: root.screens;
            sharing: root.sharing;
            recording: root.recording;
            recording-self: root.recording-self;
            share-opening: root.share-opening;
            notice: root.room-notice;
            notice-seq: root.room-notice-seq;
            toggle-share => {
                root.toggle-share();
            }
            toggle-recording => {
                root.toggle-recording();
            }
            toggle-hand => {
                root.toggle-hand();
            }
            react(index) => {
                root.react(index);
            }
            say(text) => {
                root.say(text);
            }
            columns-for(count, width, height) => {
                return root.columns-for(count, width, height);
            }
            toggle-mute => {
                root.toggle-mute();
            }
            toggle-camera => {
                root.toggle-camera();
            }
            leave => {
                root.leave();
            }
        }
    }
    if root.share-choices.length > 0: SharePicker {
        width: root.width;
        height: root.height;
        choices: root.share-choices;
        share(index) => {
            root.share(index);
        }
    }
    if root.settings-open: SettingsPanel {
        width: root.width;
        height: root.height;
        name <=> root.name;
        microphones: root.microphones;
        speakers: root.speakers;
        microphone <=> root.microphone;
        speaker <=> root.speaker;
        noise <=> root.noise;
        level: root.mic-level;
        has-devices: root.has-devices;
        choose-microphone(index) => {
            root.choose-microphone(index);
        }
        choose-speaker(index) => {
            root.choose-speaker(index);
        }
        choose-noise(index) => {
            root.choose-noise(index);
        }
        close => {
            root.settings-open = false;
            root.settings-closed();
        }
    }
    if root.asking != "": LinkQuestion {
        width: root.width;
        height: root.height;
        link: root.asking;
        room-name: root.asking-name;
        answer(leave) => {
            root.answer(leave);
        }
    }
}
