import { LineEdit, Palette } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { Icon } from "../widgets/icon.slint";
import { PillButton } from "../widgets/buttons.slint";

// Before a room: a name, an invite, Join, or a new room.
export component JoinScreen inherits Rectangle {
    in-out property <string> name;
    in-out property <string> invite;
    in property <bool> joining;
    in property <string> error;
    // Said under the card in the hint's place, as that the room was left; nothing otherwise.
    in property <string> note;
    callback join(string, string);
    // Counts the links filled in: each gives the name field the keyboard, for Enter to join.
    in property <int> filled;
    callback new-room();
    callback about();
    property <bool> born;
    // A short window gets the card without its greeting, so Join stays in it.
    property <bool> compact: root.height < 480px;
    // Typing starts with the name, whenever the screen shows.
    init => {
        name-field.focus();
    }
    // Set after the first frame: one set in `init` comes before it, and isn't animated.
    Timer {
        interval: 16ms;
        running: !root.born;
        triggered => {
            root.born = true;
        }
    }
    changed filled => {
        name-field.focus();
    }
    background: Theme.canvas;
    card := Rectangle {
        width: Math.min(400px, root.width - 32px);
        height: column.preferred-height;
        x: (root.width - self.width) / 2;
        y: Math.max(8px, (root.height - self.height) / 2 - (root.compact ? 0px : 20px)) + (root.born ? 0px : 16px);
        animate y {
            duration: 320ms;
            easing: ease-out;
        }
        opacity: root.born ? 1 : 0;
        animate opacity { duration: 320ms; }
        background: Theme.surface;
        border-radius: 16px;
        border-width: 1px;
        border-color: Theme.line;
        column := VerticalLayout {
            padding: root.compact ? 16px : 28px;
            spacing: root.compact ? 8px : 12px;
            if !root.compact: HorizontalLayout {
                alignment: center;
                spacing: 10px;
                Rectangle {
                    width: 40px;
                    height: 40px;
                    border-radius: 20px;
                    background: Theme.accent;
                    Icon {
                        kind: "mic";
                        tint: white;
                        width: 22px;
                        height: 22px;
                    }
                }
                Text {
                    text: "mic";
                    color: Theme.text;
                    font-size: 30px;
                    font-weight: 700;
                    vertical-alignment: center;
                }
            }
            if !root.compact: Text {
                text: "Video calls, end-to-end encrypted.";
                color: Theme.text-dim;
                font-size: 13px;
                horizontal-alignment: center;
                wrap: word-wrap;
            }
            if !root.compact: Rectangle { height: 4px; }
            name-field := LineEdit {
                placeholder-text: "Your name";
                accessible-label: "Your name";
                text <=> root.name;
                enabled: !root.joining;
                accepted => {
                    if (root.invite == "") {
                        invite-field.focus();
                    } else {
                        root.join(root.name, root.invite);
                    }
                }
            }
            invite-field := LineEdit {
                placeholder-text: "Invite: mic://join/…";
                accessible-label: "Invite";
                text <=> root.invite;
                enabled: !root.joining;
                accepted => {
                    root.join(root.name, root.invite);
                }
            }
            PillButton {
                text: root.joining ? "Joining…" : "Join";
                primary: true;
                busy: root.joining;
                enabled: !root.joining && root.name != "" && root.invite != "";
                clicked => {
                    root.join(root.name, root.invite);
                }
            }
            HorizontalLayout {
                spacing: 10px;
                Rectangle {
                    height: 1px;
                    y: (parent.height - self.height) / 2;
                    background: Theme.line;
                }
                Text {
                    text: "or";
                    color: Theme.text-dim;
                    font-size: 12px;
                    horizontal-stretch: 0;
                }
                Rectangle {
                    height: 1px;
                    y: (parent.height - self.height) / 2;
                    background: Theme.line;
                }
            }
            PillButton {
                text: "Start a new room";
                enabled: !root.joining && root.name != "";
                clicked => {
                    root.new-room();
                }
            }
            // Kept once a name is typed, unseen, so the card doesn't move under the pointer.
            if root.error == "" && (!root.compact || root.note != ""): Text {
                opacity: root.note != "" || root.name == "" ? 1 : 0;
                animate opacity { duration: Theme.quick; }
                text: root.note != "" ? root.note : "Type your name to join a room or start one.";
                color: Theme.text-dim;
                font-size: 12px;
                horizontal-alignment: center;
                wrap: word-wrap;
            }
            if root.error != "": Text {
                text: root.error;
                color: Theme.danger-hover;
                font-size: 13px;
                horizontal-alignment: center;
                wrap: word-wrap;
            }
        }
    }
    Text {
        x: root.width - self.width - 14px;
        y: root.height - self.height - 10px;
        text: "About mic";
        color: about-touch.has-hover ? Theme.text : Theme.text-dim;
        font-size: 12px;
        accessible-role: button;
        accessible-action-default => {
            root.about();
        }
        about-touch := TouchArea {
            mouse-cursor: pointer;
            clicked => {
                root.about();
            }
        }
    }
}

export component JoinPreview inherits Rectangle {
    // Dark, as the window sets it (app.slint).
    init => {
        Palette.color-scheme = ColorScheme.dark;
    }
    width: 700px;
    height: 560px;
    JoinScreen {
        name: "Ann Example";
        note: "You left the room.";
    }
}
