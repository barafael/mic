import { Theme } from "../theme.slint";

// A line across the top: reconnecting, a broadcast that didn't stand, a newer version.
export component Banner inherits Rectangle {
    in property <string> text;
    in property <color> tint;
    // Pulsing, while something is under way.
    in property <bool> pulsing;
    // A button at its end, as "Stop" for a share; none if empty.
    in property <string> action;
    callback acted();
    property <bool> shown;
    // Set after the first frame: one set in `init` comes before it, and isn't animated.
    Timer {
        interval: 16ms;
        running: !root.shown;
        triggered => {
            root.shown = true;
        }
    }
    height: row.preferred-height;
    border-radius: 8px;
    background: root.tint.transparentize(0.85);
    border-width: 1px;
    border-color: root.tint.transparentize(0.6);
    opacity: self.shown ? 1 : 0;
    animate opacity { duration: Theme.moving; }
    row := HorizontalLayout {
        padding: 8px;
        padding-left: 12px;
        spacing: 10px;
        Rectangle {
            width: 8px;
            Rectangle {
                width: 8px;
                height: 8px;
                border-radius: 4px;
                background: root.tint;
                opacity: root.pulsing ? 0.35 + 0.65 * Math.abs(Math.sin(animation-tick() / 1ms * 0.18deg)) : 1;
            }
        }
        Text {
            text: root.text;
            color: Theme.text;
            font-size: 13px;
            wrap: word-wrap;
            vertical-alignment: center;
        }
        if root.action != "": Rectangle {
            horizontal-stretch: 0;
            width: action-label.preferred-width + 24px;
            height: 26px;
            y: (parent.height - self.height) / 2;
            border-radius: 13px;
            background: action-touch.has-hover ? root.tint.brighter(0.15) : root.tint;
            animate background { duration: Theme.quick; }
            accessible-role: button;
            accessible-label: root.action;
            accessible-action-default => {
                root.acted();
            }
            action-label := Text {
                text: root.action;
                color: #111318;
                font-size: 12px;
                font-weight: 600;
            }
            action-touch := TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    root.acted();
                }
            }
        }
    }
}

export component BannersPreview inherits Rectangle {
    background: Theme.canvas;
    width: 520px;
    height: 170px;
    VerticalLayout {
        padding: 12px;
        spacing: 10px;
        Banner { text: "Reconnecting…"; tint: Theme.warn; pulsing: true; }
        Banner { text: "You're sharing your screen"; tint: Theme.accent; action: "Stop"; }
        Banner { text: "Bob is recording this call."; tint: Theme.danger; pulsing: true; }
    }
}
