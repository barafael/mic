import { Theme } from "../theme.slint";

// What a control says while the pointer rests on it, after a moment.
export component Tip inherits Rectangle {
    in property <string> text;
    property <bool> shown;
    // Set after the first frame: one set in `init` comes before it, and isn't animated.
    Timer {
        interval: 16ms;
        running: !root.shown;
        triggered => {
            root.shown = true;
        }
    }
    width: label.preferred-width + 16px;
    height: label.preferred-height + 8px;
    border-radius: 6px;
    background: #000000e0;
    opacity: self.shown ? 1 : 0;
    animate opacity {
        delay: 450ms;
        duration: Theme.quick;
    }
    label := Text {
        text: root.text;
        color: Theme.text;
        font-size: 12px;
    }
}

export component TipPreview inherits Rectangle {
    background: Theme.canvas;
    width: 200px;
    height: 60px;
    Tip {
        text: "Mute (Ctrl+D)";
    }
}
